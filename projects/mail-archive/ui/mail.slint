import { Button, HorizontalBox, LineEdit, ListView, TextEdit, VerticalBox } from "std-widgets.slint";

struct SearchRow {
    doc-id: int,
    date: string,
    correspondent: string,
    subject: string,
    snippet: string,
    attachment: string,
}

struct AttachmentRow {
    id: int,
    name: string,
    mime: string,
    size: string,
    previewable: bool,
}

struct UiText {
    window-title: string,
    main-accessible: string,
    file: string, new-archive: string, open-archive: string, recent-archives: string, quit: string,
    archive: string, archive-state: string, sync-now: string, syncing: string, add-gmail: string, back-search: string,
    search-menu: string, focus-search: string, clear-search: string, view: string, zoom-out: string, zoom-reset: string, zoom-in: string, help: string, about: string,
    archive-choice: string, setup-description: string, create-archive: string, archive-sync: string, local-archive: string, gmail-source: string, add-account: string,
    search-placeholder: string, search-accessible: string, clear: string, filters: string, filters-accessible: string,
    from-placeholder: string, from-accessible: string, to-placeholder: string, to-accessible: string, since-placeholder: string, since-accessible: string, until-placeholder: string, until-accessible: string,
    attachment-filter-prefix: string, attachment-filter-accessible: string, mime-placeholder: string, mime-accessible: string, reset-filters: string, labels-prefix: string, empty-search: string, results-accessible: string,
    reader-accessible: string, select-message: string, open-html: string, reduce-zoom: string, reset-zoom: string, increase-zoom: string, body-placeholder: string,
    attachment-accessible-prefix: string, preview: string, open: string, save-as: string, preview-accessible-prefix: string, preview-region-prefix: string, close: string,
}

export component MailWindow inherits Window {
    in property <UiText> texts;
    title: root.texts.window-title;
    preferred-width: 1200px;
    preferred-height: 760px;
    min-width: 760px;
    min-height: 520px;
    background: #f5f6f8;

    in property <[SearchRow]> results;
    in property <int> selected-index: -1;
    in property <string> result-count: "0 résultats";
    in property <string> message-date;
    in property <string> message-from;
    in property <string> message-to;
    in property <string> message-subject;
    in property <string> message-body;
    in property <bool> html-available: false;
    in property <string> message-attachments;
    in property <[AttachmentRow]> attachment-rows;
    in property <string> message-zoom-label: "100 %";
    in property <length> message-font-size: 14px;
    in property <string> status: "Prêt";
    in property <bool> loading: false;
    in property <bool> archive-view: false;
    in property <bool> setup-view: false;
    in property <bool> source-configured: false;
    in property <bool> syncing: false;
    in property <string> archive-message-count: "0 messages";
    in property <string> archive-size: "Archive vide";
    in property <string> archive-segments: "0 segments";
    in property <string> archive-catalog: "Catalogue indisponible";
    in property <string> archive-index: "Index non construit";
    in property <string> source-status: "Source Gmail non configurée";
    in property <string> sync-progress: "";
    in property <int> sync-current: 0;
    in property <int> sync-total: -1;
    in property <float> sync-fraction: 0.0;
    in property <bool> sync-determinate: false;
    in property <bool> filters-open: false;
    in-out property <string> from-filter;
    in-out property <string> to-filter;
    in-out property <string> date-from-filter;
    in-out property <string> date-to-filter;
    in property <string> attachment-filter: "Toutes";
    in property <string> attachment-filter-label: "Toutes";
    in-out property <string> attachment-mime-filter;
    in property <[string]> label-options;
    in property <int> active-filter-count: 0;
    in property <string> setup-status: "Choisissez une archive pour commencer.";
    in property <bool> preview-visible: false;
    in property <image> preview-image;
    in property <string> preview-title;
    in property <string> preview-status;
    in-out property <string> query;

    callback search-changed(string);
    callback search-submitted(string);
    callback result-selected(int);
    callback clear-search();
    callback selection-move(int);
    callback zoom-change(int);
    callback show-archive();
    callback show-search();
    callback sync-requested();
    callback refresh-search-index() -> bool;
    callback open-archive-requested();
    callback create-archive-requested();
    callback add-source-requested();
    callback quit-requested();
    callback open-attachment(int);
    callback save-attachment(int);
    callback open-html();
    callback preview-attachment(int);
    callback close-preview();
    callback toggle-filters();
    callback filters-changed();
    callback reset-filters();
    callback cycle-attachment-filter();
    callback toggle-label(int);

    accessible-role: AccessibleRole.main;
    accessible-label: root.texts.main-accessible;

    init => { search_field.focus(); }

    function ensure-selected-visible() {
        if root.selected-index < 0 || root.selected-index >= root.results.length {
            return;
        }
        let item-height = 82px;
        let item-y = root.selected-index * item-height + results_view.viewport-y;
        if item-y < 0px {
            results_view.viewport-y -= item-y;
        } else if item-y + item-height > results_view.visible-height {
            results_view.viewport-y -= item-y + item-height - results_view.visible-height;
        }
    }

    MenuBar {
        Menu {
            title: root.texts.file;
            MenuItem { title: root.texts.new-archive; activated => { root.create-archive-requested(); } }
            MenuItem { title: root.texts.open-archive; activated => { root.open-archive-requested(); } }
            MenuItem { title: root.texts.recent-archives; activated => { root.open-archive-requested(); } }
            MenuSeparator { }
            MenuItem { title: root.texts.quit; activated => { root.quit-requested(); } }
        }
        Menu {
            title: root.texts.archive;
            MenuItem {
                title: root.texts.archive-state;
                activated => { root.show-archive(); }
            }
            MenuItem {
                title: root.texts.sync-now;
                enabled: root.source-configured && !root.syncing;
                activated => { root.sync-requested(); }
            }
            MenuItem {
                title: root.texts.add-gmail;
                enabled: !root.syncing;
                activated => { root.add-source-requested(); }
            }
            MenuItem {
                title: root.texts.back-search;
                enabled: root.archive-view;
                activated => { root.show-search(); }
            }
        }
        Menu {
            title: root.texts.search-menu;
            MenuItem {
                title: root.texts.focus-search;
                shortcut: @keys(Control + F);
                activated => { search_field.focus(); }
            }
            MenuItem {
                title: root.texts.clear-search;
                shortcut: @keys(Control + Backspace);
                activated => { root.clear-search(); search_field.text = ""; search_field.focus(); }
            }
        }
        Menu {
            title: root.texts.view;
            MenuItem { title: root.texts.zoom-out; enabled: false; }
            MenuItem { title: root.texts.zoom-reset; enabled: false; }
            MenuItem { title: root.texts.zoom-in; enabled: false; }
        }
        Menu {
            title: root.texts.help;
            MenuItem { title: root.texts.about; enabled: false; }
        }
    }

    if root.setup-view: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #f5f6f8;
        accessible-role: AccessibleRole.region;
        accessible-label: root.texts.archive-choice;
        VerticalBox {
            width: min(parent.width - 80px, 560px);
            x: (parent.width - self.width) / 2;
            y: 120px;
            spacing: 14px;
            Text { text: "Memoria"; color: #202633; font-size: 28px; }
            Text {
                text: root.texts.setup-description;
                color: #667085;
                wrap: word-wrap;
            }
            Text { text: root.setup-status; color: #9a3412; wrap: word-wrap; }
            HorizontalBox {
                spacing: 12px;
                Button {
                    text: root.texts.open-archive;
                    accessible-label: root.texts.open-archive;
                    clicked => { root.open-archive-requested(); }
                }
                Button {
                    text: root.texts.create-archive;
                    accessible-label: root.texts.create-archive;
                    clicked => { root.create-archive-requested(); }
                }
            }
        }
    }

    if root.archive-view: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #f5f6f8;
        accessible-role: AccessibleRole.region;
        accessible-label: root.texts.archive-sync;
        VerticalBox {
            padding: 28px;
            spacing: 18px;
            Text {
                text: root.texts.archive-sync;
                color: #202633;
                font-size: 24px;
                vertical-alignment: center;
            }
            HorizontalBox {
                spacing: 18px;
                Rectangle {
                    horizontal-stretch: 1;
                    background: white;
                    border-width: 1px;
                    border-color: #d9dde5;
                    border-radius: 6px;
                    VerticalBox {
                        padding: 18px;
                        spacing: 10px;
                        Text { text: root.texts.local-archive; color: #202633; font-size: 17px; }
                        Text { text: root.archive-message-count; color: #344054; }
                        Text { text: root.archive-size; color: #344054; }
                        Text { text: root.archive-segments; color: #344054; }
                        Text { text: root.archive-catalog; color: #667085; }
                        Text { text: root.archive-index; color: #667085; }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    background: white;
                    border-width: 1px;
                    border-color: #d9dde5;
                    border-radius: 6px;
                    VerticalBox {
                        padding: 18px;
                        spacing: 10px;
                        Text { text: root.texts.gmail-source; color: #202633; font-size: 17px; }
                        Text {
                            text: root.source-status;
                            color: root.source-configured ? #344054 : #9a3412;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.sync-progress;
                            color: #667085;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            height: 8px;
                            background: #e5e7eb;
                            border-radius: 4px;
                            Rectangle {
                                width: root.sync-determinate ? parent.width * root.sync-fraction : (root.syncing ? parent.width * 0.35 : 0px);
                                height: parent.height;
                                background: #0f766e;
                                border-radius: 4px;
                            }
                        }
                        if !root.source-configured: Button {
                            text: root.texts.add-account;
                            accessible-label: root.texts.add-gmail;
                            clicked => { root.add-source-requested(); }
                        }
                        Button {
                            text: root.syncing ? root.texts.syncing : root.texts.sync-now;
                            enabled: root.source-configured && !root.syncing;
                            accessible-label: root.texts.sync-now;
                            clicked => { root.sync-requested(); }
                        }
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }

    scope := FocusScope {
        width: parent.width;
        height: parent.height;
        visible: !root.archive-view && !root.setup-view;
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                if root.preview-visible {
                    root.close-preview();
                } else if root.message-subject != "" {
                    result_scope.focus();
                } else {
                    root.clear-search();
                    search_field.text = "";
                    search_field.focus();
                }
                accept;
            } else if event.modifiers.control && event.text == "f" {
                search_field.focus();
                accept;
            } else if event.modifiers.control && event.text == Key.Backspace {
                root.clear-search();
                search_field.text = "";
                search_field.focus();
                accept;
            } else if event.modifiers.control && (event.text == "+" || event.text == "=") {
                root.zoom-change(1);
                accept;
            } else if event.modifiers.control && event.text == "-" {
                root.zoom-change(-1);
                accept;
            } else if event.modifiers.control && event.text == "0" {
                root.zoom-change(0);
                accept;
            } else if event.text == Key.UpArrow {
                root.selection-move(-1);
                result_scope.focus();
                root.ensure-selected-visible();
                accept;
            } else if event.text == Key.DownArrow {
                root.selection-move(1);
                result_scope.focus();
                root.ensure-selected-visible();
                accept;
            } else if event.text == Key.PageUp {
                root.selection-move(-10);
                result_scope.focus();
                root.ensure-selected-visible();
                accept;
            } else if event.text == Key.PageDown {
                root.selection-move(10);
                result_scope.focus();
                root.ensure-selected-visible();
                accept;
            } else if event.text == Key.Home {
                root.selection-move(-1000000);
                result_scope.focus();
                root.ensure-selected-visible();
                accept;
            } else if event.text == Key.End {
                root.selection-move(1000000);
                result_scope.focus();
                root.ensure-selected-visible();
                accept;
            } else if event.text == Key.Return {
                if root.selected-index >= 0 {
                    root.result-selected(root.selected-index);
                }
                accept;
            }
            reject
        }

        Rectangle {
            background: #f5f6f8;
            VerticalBox {
            padding: 18px;
            spacing: 12px;

            HorizontalBox {
                height: 44px;
                Text {
                    text: root.texts.window-title;
                    color: #202633;
                    font-size: 22px;
                    vertical-alignment: center;
                }
                Rectangle { width: 18px; }
                search_field := LineEdit {
                    horizontal-stretch: 1;
                    height: 36px;
                    text: root.query;
                    placeholder-text: root.texts.search-placeholder;
                    accessible-label: root.texts.search-accessible;
                    edited(text) => { root.query = text; root.search-changed(text); }
                    accepted => { root.search-submitted(self.text); }
                }
                Button {
                    text: root.texts.clear;
                    accessible-label: root.texts.clear-search;
                    clicked => { root.clear-search(); search_field.text = ""; search_field.focus(); }
                }
                Button {
                    text: root.filters-open ? root.texts.filters + " ▲" : (root.active-filter-count > 0 ? root.texts.filters + " (" + root.active-filter-count + ")" : root.texts.filters);
                    accessible-label: root.texts.filters-accessible;
                    clicked => { root.toggle-filters(); }
                }
            }

            if root.filters-open: Rectangle {
                height: 118px;
                background: #eef1f5;
                border-width: 1px;
                border-color: #d9dde5;
                border-radius: 5px;
                VerticalBox {
                    padding: 8px;
                    spacing: 5px;
                    HorizontalBox {
                        spacing: 6px;
                        LineEdit {
                            horizontal-stretch: 1;
                            text: root.from-filter;
                            placeholder-text: root.texts.from-placeholder;
                            accessible-label: root.texts.from-accessible;
                            edited(text) => { root.from-filter = text; root.filters-changed(); }
                        }
                        LineEdit {
                            horizontal-stretch: 1;
                            text: root.to-filter;
                            placeholder-text: root.texts.to-placeholder;
                            accessible-label: root.texts.to-accessible;
                            edited(text) => { root.to-filter = text; root.filters-changed(); }
                        }
                        LineEdit {
                            horizontal-stretch: 1;
                            text: root.date-from-filter;
                            placeholder-text: root.texts.since-placeholder;
                            accessible-label: root.texts.since-accessible;
                            edited(text) => { root.date-from-filter = text; root.filters-changed(); }
                        }
                        LineEdit {
                            horizontal-stretch: 1;
                            text: root.date-to-filter;
                            placeholder-text: root.texts.until-placeholder;
                            accessible-label: root.texts.until-accessible;
                            edited(text) => { root.date-to-filter = text; root.filters-changed(); }
                        }
                    }
                    HorizontalBox {
                        spacing: 6px;
                        Button {
                            text: root.texts.attachment-filter-prefix + root.attachment-filter-label;
                            accessible-label: root.texts.attachment-filter-accessible;
                            clicked => { root.cycle-attachment-filter(); }
                        }
                        LineEdit {
                            horizontal-stretch: 1;
                            text: root.attachment-mime-filter;
                            placeholder-text: root.texts.mime-placeholder;
                            accessible-label: root.texts.mime-accessible;
                            edited(text) => { root.attachment-mime-filter = text; root.filters-changed(); }
                        }
                        Button {
                            text: root.texts.reset-filters;
                            accessible-label: root.texts.reset-filters;
                            clicked => { root.reset-filters(); }
                        }
                    }
                    HorizontalBox {
                        spacing: 4px;
                        Text { text: root.label-options.length > 0 ? root.texts.labels-prefix : ""; color: #667085; vertical-alignment: center; }
                        for option[index] in root.label-options : Button {
                            text: option;
                            clicked => { root.toggle-label(index); }
                        }
                    }
                }
            }

            HorizontalBox {
                spacing: 12px;
                VerticalBox {
                    horizontal-stretch: 2;
                    spacing: 8px;
                    HorizontalBox {
                        height: 24px;
                        Text { text: root.result-count; color: #667085; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.loading ? "Recherche…" : root.status; color: #667085; vertical-alignment: center; }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        background: white;
                        border-width: 1px;
                        border-color: #d9dde5;
                        border-radius: 6px;
                        Text {
                            text: root.results.length == 0 ? root.texts.empty-search : "";
                            color: #667085;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            accessible-label: root.texts.empty-search;
                        }
                        result_scope := FocusScope {
                            width: parent.width;
                            height: parent.height;
                            results_view := ListView {
                            accessible-label: root.texts.results-accessible;
                            for row[index] in root.results : Rectangle {
                                width: parent.width;
                                height: 82px;
                                background: index == root.selected-index ? #e2f1ef : #ffffff;
                                accessible-role: AccessibleRole.list-item;
                                accessible-label: row.correspondent + " — " + row.subject + " — " + row.date;
                                HorizontalBox {
                                    padding: 10px;
                                    spacing: 10px;
                                    VerticalBox {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        HorizontalBox {
                                            Text { text: row.correspondent; color: #202633; font-size: 13px; }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text { text: row.date; color: #667085; font-size: 11px; }
                                        }
                                        Text { text: row.subject; color: #202633; font-size: 14px; overflow: elide; }
                                        Text { text: row.snippet; color: #667085; font-size: 11px; overflow: elide; }
                                    }
                                    Text { text: row.attachment; color: #667085; vertical-alignment: center; }
                                }
                                TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    clicked => { root.result-selected(index); }
                                }
                                Rectangle {
                                    y: parent.height - 1px;
                                    width: parent.width;
                                    height: 1px;
                                    background: #edf0f3;
                                }
                            }
                        }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 3;
                    background: white;
                    border-width: 1px;
                    border-color: #d9dde5;
                    border-radius: 6px;
                    accessible-role: AccessibleRole.region;
                    accessible-label: root.texts.reader-accessible;
                    VerticalBox {
                        padding: 18px;
                        spacing: 8px;
                        HorizontalBox {
                            Text {
                                text: root.message-subject == "" ? root.texts.select-message : root.message-subject;
                                color: #202633;
                                font-size: 18px;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: root.texts.open-html;
                                enabled: root.html-available;
                                accessible-label: "Ouvrir le message HTML dans le navigateur";
                                clicked => { root.open-html(); }
                            }
                            Button {
                                text: "−";
                                accessible-label: root.texts.reduce-zoom;
                                clicked => { root.zoom-change(-1); }
                            }
                            Button {
                                text: root.message-zoom-label;
                                accessible-label: root.texts.reset-zoom;
                                clicked => { root.zoom-change(0); }
                            }
                            Button {
                                text: "+";
                                accessible-label: root.texts.increase-zoom;
                                clicked => { root.zoom-change(1); }
                            }
                        }
                        Text { text: root.message-date; color: #667085; font-size: 11px; }
                        Text { text: root.message-from; color: #344054; font-size: 12px; overflow: elide; }
                        Text { text: root.message-to; color: #344054; font-size: 12px; overflow: elide; }
                        Text { text: root.message-attachments; color: #667085; font-size: 11px; }
                        if root.attachment-rows.length > 0: Rectangle {
                            height: min(112px, 28px + root.attachment-rows.length * 28px);
                            border-width: 1px;
                            border-color: #e5e7eb;
                            border-radius: 4px;
                            VerticalBox {
                                padding: 5px;
                                spacing: 2px;
                                for attachment[index] in root.attachment-rows : HorizontalBox {
                                    height: 24px;
                                    spacing: 6px;
                                    Text {
                                        text: attachment.name + " · " + attachment.mime + " · " + attachment.size;
                                        color: #344054;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        accessible-label: root.texts.attachment-accessible-prefix + attachment.name;
                                    }
                                    Button {
                                        text: root.texts.preview;
                                        enabled: attachment.previewable;
                                        accessible-label: root.texts.preview-accessible-prefix + attachment.name;
                                        clicked => { root.preview-attachment(attachment.id); }
                                    }
                                    Button {
                                        text: root.texts.open;
                                        accessible-label: root.texts.open + " " + root.texts.attachment-accessible-prefix + attachment.name;
                                        clicked => { root.open-attachment(attachment.id); }
                                    }
                                    Button {
                                        text: root.texts.save-as;
                                        accessible-label: root.texts.save-as + " " + root.texts.attachment-accessible-prefix + attachment.name;
                                        clicked => { root.save-attachment(attachment.id); }
                                    }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: #e5e7eb; }
                        TextEdit {
                            vertical-stretch: 1;
                            read-only: true;
                            text: root.message-body == "" ? root.texts.body-placeholder : root.message-body;
                            font-size: root.message-font-size;
                            wrap: word-wrap;
                            accessible-label: "Corps du message (sélectionnable et copiable)";
                        }
                    }
                }
            }
            }
        }
    }

    if root.preview-visible: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #101828cc;
        accessible-role: AccessibleRole.region;
        accessible-label: root.texts.preview-region-prefix + root.preview-title;
        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.close-preview(); }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 48px, 980px);
            height: min(parent.height - 48px, 760px);
            background: #ffffff;
            border-radius: 8px;
            border-width: 1px;
            border-color: #d0d5dd;
            VerticalBox {
                padding: 12px;
                spacing: 8px;
                HorizontalBox {
                    height: 32px;
                    Text {
                        text: root.preview-title;
                        font-size: 14px;
                        color: #202633;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Button {
                        text: root.texts.close;
                        accessible-label: root.texts.close;
                        clicked => { root.close-preview(); }
                    }
                }
                Rectangle {
                    background: #f2f4f7;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    clip: true;
                    Image {
                        source: root.preview-image;
                        image-fit: ImageFit.contain;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                    if root.preview-status != "": Text {
                        text: root.preview-status;
                        color: #667085;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        // Keep the modal panel interactive while making each surrounding edge
        // an explicit outside-click target. This is more reliable than a
        // full-surface TouchArea placed behind the panel on native backends.
        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: (parent.height - min(parent.height - 48px, 760px)) / 2;
            clicked => { root.close-preview(); }
        }
        TouchArea {
            x: 0px;
            y: (parent.height + min(parent.height - 48px, 760px)) / 2;
            width: parent.width;
            height: (parent.height - min(parent.height - 48px, 760px)) / 2;
            clicked => { root.close-preview(); }
        }
        TouchArea {
            x: 0px;
            y: (parent.height - min(parent.height - 48px, 760px)) / 2;
            width: (parent.width - min(parent.width - 48px, 980px)) / 2;
            height: min(parent.height - 48px, 760px);
            clicked => { root.close-preview(); }
        }
        TouchArea {
            x: (parent.width + min(parent.width - 48px, 980px)) / 2;
            y: (parent.height - min(parent.height - 48px, 760px)) / 2;
            width: (parent.width - min(parent.width - 48px, 980px)) / 2;
            height: min(parent.height - 48px, 760px);
            clicked => { root.close-preview(); }
        }
    }

}
